rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shop images - shop owners can upload, everyone can read
    match /shops/{shopId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Product images - shop owners can upload, everyone can read
    match /products/{productId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User profile images - users can upload their own, everyone can read
    match /users/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // General uploads - authenticated users only
    match /uploads/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Admin access (replace with your admin UID)
    match /{allPaths=**} {
      allow read, write: if request.auth != null && 
        request.auth.uid in ['ADMIN_UID_1', 'ADMIN_UID_2']; // Replace with actual admin UIDs
    }
  }
}
